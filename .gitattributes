# Normalise text in the repo; keep data files LF on every OS so hashes and tests match.
* text=auto
*.toml text eol=lf
*.lua text eol=lf
*.cs text
*.png binary
data/sprites/**/*.png filter=lfs diff=lfs merge=lfs -text
art/**/*.png filter=lfs diff=lfs merge=lfs -text
data/audio/**/*.wav filter=lfs diff=lfs merge=lfs -text
data/music/*.ogg filter=lfs diff=lfs merge=lfs -text
