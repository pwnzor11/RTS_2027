<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sim\Sim.csproj" />
    <ProjectReference Include="..\Data\Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
  </ItemGroup>

  <!-- Game data (rules, maps, sprites) beside the exe, where RulesLocator looks (C-1). -->
  <ItemGroup>
    <None Include="..\..\data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Licence and notices travel with every build and publish (E-1, E-7). -->
  <ItemGroup>
    <None Include="..\..\LICENSE;..\..\NOTICE.md;..\..\THIRD_PARTY_NOTICES.md;..\..\THIRD_PARTY_LGPL-2.0.txt" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
